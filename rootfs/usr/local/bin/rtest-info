#!/usr/bin/env bash
# rtest-info: print the toolchain versions and the current runs.
set -uo pipefail
# shellcheck source=../lib/rtest/common.sh
. /usr/local/lib/rtest/common.sh
load_env

v() { printf '%-8s %s\n' "$1" "$("${@:2}" 2>&1 | head -n 1)"; }
v go go version
v node node --version
v pnpm pnpm --version
v python python3 --version
v uv uv --version
v rust rustc --version
v cargo cargo --version
v docker docker version --format '{{.Server.Version}}'
prune "$RTEST_ACTIVE" 2>/dev/null
prune "$RTEST_QUEUE" 2>/dev/null
running=$(find "$RTEST_ACTIVE" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
printf '%-8s %s\n' running "$running"
printf '%-8s %s\n' queued "$(find "$RTEST_QUEUE" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)"
if admit "$running"; then
  printf '%-8s %s\n' room 'yes, a new run starts now'
else
  printf '%-8s %s\n' room "no, a new run waits: $why"
fi
printf '%-8s %s\n' mirrors "$(find "$RTEST_SOURCES" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null | wc -l)"
printf '%-8s %s\n' disk "$(df -h "$RTEST_ROOT" | awk 'NR == 2 { print $3 " used, " $4 " free" }')"
