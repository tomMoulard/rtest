#!/usr/bin/env bash
# rtest: run a command on a remote rtest server, on a copy of the current
# project, and exit with the exit status of the command.
#
# It works with bash 3.2 (macOS) and with openrsync (macOS) or GNU rsync.
set -uo pipefail

RTEST_VERSION=0.1.0

usage() {
  cat <<'EOF'
Usage: rtest [options] [--] COMMAND [ARGS...]
       rtest --info

Copies the project to the rtest server, runs COMMAND there from the same
relative directory, streams the output, and exits with the exit status of
COMMAND. The remote copy is deleted when COMMAND ends.

A single COMMAND argument is a shell script: rtest 'go vet ./... && go test ./...'
Several arguments are one command with its arguments: rtest go test -run TestX ./pkg

Options:
  -H, --host HOST      SSH destination (default: $RTEST_HOST, else "rtest")
  -C, --dir DIR        project directory to copy (default: the git top level,
                       else the current directory)
  -e, --env NAME=VALUE set a variable for COMMAND (repeatable)
  -t, --timeout SECS   stop COMMAND after SECS seconds (exit status 124)
  -k, --keep           keep the remote copy, for debugging
  -q, --quiet          do not print the rtest status lines
      --info           print the server toolchain versions and exit
  -h, --help           print this help
  -V, --version        print the version

Environment:
  RTEST_HOST     default SSH destination
  RTEST_SSH      SSH command (default: "ssh")
  RTEST_NO_MUX   set to 1 to disable SSH connection sharing

Exit status: the exit status of COMMAND, 124 on timeout, 125 when rtest
cannot prepare the run, 255 when SSH fails.
EOF
}

say() { [ "$quiet" = 1 ] || echo "rtest: $*" >&2; }
fail() {
  echo "rtest: $*" >&2
  exit 125
}

host=${RTEST_HOST:-rtest}
dir='' timeout=0 keep=0 quiet=0 info=0
envs=()
while [ $# -gt 0 ]; do
  case $1 in
    -H | --host) host=${2:?missing value for $1}; shift 2 ;;
    -C | --dir) dir=${2:?missing value for $1}; shift 2 ;;
    -e | --env)
      case ${2:-} in
        [A-Za-z_]*=*) envs+=("$2") ;;
        *) fail "invalid --env '${2:-}', want NAME=VALUE" ;;
      esac
      shift 2
      ;;
    -t | --timeout) timeout=${2:?missing value for $1}; shift 2 ;;
    -k | --keep) keep=1; shift ;;
    -q | --quiet) quiet=1; shift ;;
    --info) info=1; shift ;;
    -h | --help) usage; exit 0 ;;
    -V | --version) echo "rtest $RTEST_VERSION"; exit 0 ;;
    --) shift; break ;;
    -*) fail "unknown option '$1', see rtest --help" ;;
    *) break ;;
  esac
done
case $timeout in '' | *[!0-9]*) fail "invalid --timeout '$timeout'" ;; esac

# SSH connection sharing: the sync and the run, and parallel runs, reuse one
# connection, which removes most of the connection time.
ssh_cmd=${RTEST_SSH:-ssh}
if [ "${RTEST_NO_MUX:-0}" != 1 ]; then
  ssh_cmd="$ssh_cmd -o ControlMaster=auto -o ControlPath=$HOME/.ssh/rtest-%C -o ControlPersist=10m"
fi

if [ "$info" = 1 ]; then
  # shellcheck disable=SC2086
  exec $ssh_cmd "$host" rtest-info
fi
[ $# -gt 0 ] || { usage >&2; exit 125; }
command -v rsync >/dev/null || fail 'rsync is not installed'

# The project root and the directory to run from, relative to the root.
here=$(pwd -P)
if [ -z "$dir" ]; then
  dir=$(git -C "$here" rev-parse --show-toplevel 2>/dev/null) || dir=$here
fi
root=$(cd "$dir" 2>/dev/null && pwd -P) || fail "no such directory: $dir"
case $here/ in
  "$root"/*) rel=${here#"$root"} rel=${rel#/} ;;
  *) rel='' ;;
esac

# Cache identity. The mirror KEY is per machine and per directory, so that
# parallel runs of one checkout share one mirror. The SEED names the
# repository, so that a new worktree starts from a copy of another worktree.
hash() { printf %s "$1" | cksum | awk '{ print $1 }'; }
name=$(basename "$root" | tr -c 'A-Za-z0-9._\n-' '_' | cut -c 1-40)
case $name in .*) name=_${name#.} ;; esac
key=$name-$(hash "$(hostname -s 2>/dev/null || hostname):$root")
seed=-
origin=$(git -C "$root" config --get remote.origin.url 2>/dev/null) &&
  seed=repo-$(hash "$origin")
run=$(date +%Y%m%d-%H%M%S)-$$-$RANDOM

tmp=$(mktemp -d "${TMPDIR:-/tmp}/rtest.XXXXXX") || fail 'cannot create a temporary directory'
keeper='' sshpid=''
cleanup() {
  [ -z "$sshpid" ] || kill "$sshpid" 2>/dev/null
  [ -z "$keeper" ] || kill "$keeper" 2>/dev/null
  rm -rf "$tmp"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Exclude what git ignores. In a git work tree, git itself lists the ignored
# paths, which follows every gitignore rule. Elsewhere, rsync reads the
# .gitignore files. .rtestignore adds rsync exclude patterns.
excl=$tmp/exclude
printf '%s\n' .git >"$excl"
filters=()
if [ "$(git -C "$root" rev-parse --is-inside-work-tree 2>/dev/null)" = true ]; then
  git -C "$root" ls-files -z --others --ignored --exclude-standard --directory |
    tr '\0' '\n' | sed -e 's/[][*?\\]/\\&/g' -e 's|^|/|' >>"$excl"
else
  filters=(-f ':- .gitignore')
fi
[ ! -f "$root/.rtestignore" ] || filters+=("--exclude-from=$root/.rtestignore")

say "sync $root -> $host"
start=$(date +%s)
rsync -rlptz --delete --delete-excluded --exclude-from="$excl" \
  ${filters[@]+"${filters[@]}"} \
  -e "$ssh_cmd" --rsync-path="rtest-sync $key $run $seed" \
  "$root/" "$host:/work/sources/$key/"
rc=$?
[ "$rc" -eq 0 ] || fail "sync failed (rsync exit status $rc)"
say "synced in $(($(date +%s) - start))s, run $run"

# The remote script: variables, directory, then the command.
script=''
for kv in ${envs[@]+"${envs[@]}"}; do
  script="${script}export ${kv%%=*}=$(printf %q "${kv#*=}")"$'\n'
done
[ -z "$rel" ] || script="${script}cd $(printf %q "$rel") || exit 125"$'\n'
if [ $# -eq 1 ]; then
  script="$script$1"
else
  script="$script$(printf '%q ' "$@")"
fi
encoded=$(printf %s "$script" | base64 | tr -d '\n')

opts=''
[ "$keep" = 0 ] || opts="$opts --keep"
[ "$timeout" = 0 ] || opts="$opts --timeout $timeout"

# With a terminal, SSH allocates a remote terminal: colors work and Ctrl-C
# stops the remote command. Without one (CI, agents), stdin stays open for the
# duration of the run, and the server stops the command when stdin closes.
# SSH exit status 255 means that the connection failed.
# shellcheck disable=SC2086
if [ -t 0 ] && [ -t 1 ]; then
  $ssh_cmd -t "$host" rtest-exec $opts "$run" "$encoded"
  rc=$?
else
  mkfifo "$tmp/stdin"
  sleep 2147483647 >"$tmp/stdin" &
  keeper=$!
  # SSH runs in the background, so that a signal reaches the traps at once.
  $ssh_cmd "$host" rtest-exec $opts "$run" "$encoded" <"$tmp/stdin" &
  sshpid=$!
  wait "$sshpid"
  rc=$?
  sshpid=''
fi
say "exit status $rc"
exit "$rc"
